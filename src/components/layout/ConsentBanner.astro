---
/**
 * Cookie consent: a non-blocking panel placed first in the tab order, plus a
 * preferences dialog. No dark patterns: "Reject non-essential" and "Accept
 * all" have identical styling and weight, nothing is pre-ticked, and the
 * same three choices are available inside the dialog. Only rendered when an
 * analytics or marketing tag is configured.
 */
import { useTranslations, type Locale } from '@/i18n';
import { vendorsFor } from '@/config/privacy';
import { getLegalUrl } from '@/lib/content';
import Button from '../ui/Button.astro';
import Modal from '../ui/Modal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const cookiesUrl = await getLegalUrl(locale, 'cookies');
const vendors = { analytics: vendorsFor('analytics'), marketing: vendorsFor('marketing') };
---

<section class="consent" aria-labelledby="consent-title" hidden data-consent-banner>
  <div class="consent__inner">
    <div class="consent__text">
      <h2 id="consent-title" class="consent__title">{t.consent.title}</h2>
      <p>
        {t.consent.text} <a href={cookiesUrl}>{t.consent.policyLink}</a>
      </p>
    </div>
    <div class="consent__actions">
      <Button variant="secondary" icon={false} data-consent-action="reject">{t.consent.rejectAll}</Button>
      <Button variant="secondary" icon={false} data-consent-action="accept">{t.consent.acceptAll}</Button>
      <Button variant="link" icon={false} data-modal-open="consent-settings" aria-haspopup="dialog">{t.consent.customize}</Button>
    </div>
  </div>
</section>

<Modal id="consent-settings" title={t.consent.dialogTitle} closeLabel={t.a11y.close}>
  <p class="consent-form__intro">{t.consent.dialogIntro}</p>
  {/* Submitted by script only. The explicit action keeps the address's
      fragment (e.g. a search query) out of analytics "form" events. */}
  <form class="consent-form" action={Astro.url.pathname} data-consent-form>
    <div class="consent-form__row">
      <div>
        <p class="consent-form__label">{t.consent.necessaryTitle}</p>
        <p class="consent-form__desc">{t.consent.necessaryText}</p>
      </div>
      <span class="consent-form__always mono">{t.consent.alwaysOn}</span>
    </div>
    <label class="consent-form__row">
      <span>
        <span class="consent-form__label">{t.consent.analyticsTitle}</span>
        <span class="consent-form__desc">{t.consent.analyticsText}</span>
        {vendors.analytics.length > 0 && <span class="consent-form__desc">{t.consent.providers} {vendors.analytics.join(', ')}</span>}
      </span>
      <input type="checkbox" name="analytics" class="switch" />
    </label>
    <label class="consent-form__row">
      <span>
        <span class="consent-form__label">{t.consent.marketingTitle}</span>
        <span class="consent-form__desc">{vendors.marketing.length > 0 ? t.consent.marketingText : t.consent.marketingTextNoAds}</span>
        {vendors.marketing.length > 0 && <span class="consent-form__desc">{t.consent.providers} {vendors.marketing.join(', ')}</span>}
        <span class="consent-form__desc consent-form__gpc" hidden data-gpc-note>{t.consent.gpcNote}</span>
      </span>
      <input type="checkbox" name="marketing" class="switch" />
    </label>
    <div class="consent-form__actions">
      <Button type="submit" variant="secondary" icon={false}>{t.consent.save}</Button>
      <Button variant="secondary" icon={false} data-consent-action="reject">{t.consent.rejectAll}</Button>
      <Button variant="secondary" icon={false} data-consent-action="accept">{t.consent.acceptAll}</Button>
    </div>
    <p class="consent-form__desc"><a href={cookiesUrl}>{t.consent.policyLink}</a></p>
  </form>
</Modal>

<script>
  import { initConsent } from '@/scripts/analytics/consent';
  initConsent();
</script>

<style>
  .consent {
    position: fixed;
    inset-inline: max(0.75rem, env(safe-area-inset-left));
    inset-block-end: max(0.75rem, env(safe-area-inset-bottom));
    z-index: var(--z-toast);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .consent__inner {
    pointer-events: auto;
    display: grid;
    gap: var(--space-m);
    width: min(100%, 64rem);
    padding: var(--space-m) var(--space-l);
    background: var(--color-surface-2);
    border: 1px solid var(--color-line-strong);
    box-shadow: var(--shadow-overlay);
  }

  @media (min-width: 64rem) {
    .consent__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .consent__title {
    font-size: var(--step-0);
    font-weight: 650;
    margin-block-end: 0.25rem;
  }

  .consent__text p {
    font-size: var(--step--1);
    color: var(--color-text-2);
    max-width: 62ch;
  }

  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .consent-form {
    display: grid;
    gap: 0;
  }

  .consent-form__intro {
    color: var(--color-text-2);
    margin-block-end: var(--space-s);
  }

  .consent-form__gpc {
    color: var(--color-text-2);
    margin-block-start: 0.25rem;
  }

  .consent-form__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
    border: 0;
    border-bottom: 1px solid var(--color-line);
    margin: 0;
    padding-inline: 0;
    cursor: pointer;
  }

  .consent-form__label {
    display: block;
    font-weight: 600;
  }

  .consent-form__desc {
    display: block;
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .consent-form__always {
    color: var(--color-accent);
    white-space: nowrap;
  }

  .consent-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: var(--space-m) var(--space-s);
  }

  .consent-form__row:has(input:disabled) {
    cursor: not-allowed;
  }

  .switch:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .switch:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }


  .switch {
    appearance: none;
    flex-shrink: 0;
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    cursor: pointer;
    transition: background-color var(--dur-2);
  }

  .switch::after {
    content: '';
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--color-control-knob);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .switch:checked {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .switch:checked::after {
    background: var(--color-on-primary);
    transform: translateX(1.25rem);
  }

  :global([dir='rtl']) .switch:checked::after {
    transform: translateX(-1.25rem);
  }

  /* Windows High Contrast: keep the on/off state visible with system colours. */
  @media (forced-colors: active) {
    .switch {
      forced-color-adjust: none;
      border-color: ButtonText;
      background: Canvas;
    }
    .switch::after {
      background: ButtonText;
    }
    .switch:checked {
      border-color: Highlight;
      background: Highlight;
    }
    .switch:checked::after {
      background: HighlightText;
    }
  }
</style>
