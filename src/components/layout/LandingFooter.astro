---
import { footerNav } from '@/config/navigation';
import { site } from '@/config/site';
import { useTranslations, type Locale } from '@/i18n';
import { getLegalUrl } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const legalLinks = await Promise.all(footerNav.legal.map(async (key) => ({ key, url: await getLegalUrl(locale, key) })));
---

<footer class="landing-footer">
  <div class="container landing-footer__inner">
    <p>© {new Date().getFullYear()} {site.legalName ?? site.name} · {t.footer.based}</p>
    <ul role="list">
      {
        legalLinks.map(({ key, url }) => (
          <li>
            <a href={url}>{t.nav[key]}</a>
          </li>
        ))
      }
      <li>
        <button type="button" data-consent-open hidden>{t.nav.cookieSettings}</button>
      </li>
    </ul>
  </div>
</footer>

<style>
  .landing-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-l) calc(var(--space-l) + 4rem);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .landing-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
  }

  .landing-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .landing-footer a,
  .landing-footer button {
    color: inherit;
    text-decoration: none;
    font-size: inherit;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
  }

  .landing-footer a:hover,
  .landing-footer button:hover {
    color: var(--color-text);
  }
</style>
