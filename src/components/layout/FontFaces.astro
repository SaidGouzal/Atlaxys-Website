---
/**
 * Self-hosted variable fonts (no third-party requests, GDPR-friendly).
 *
 *  • Archivo (wdth 62–125, wght 100–900): display + text, one file for Latin.
 *  • JetBrains Mono (wght): metadata labels.
 *  • Noto Kufi Arabic (wght): Arabic pages only — `unicode-range` means the
 *    file is only downloaded when Arabic characters are on the page.
 *
 * The Latin Archivo file is preloaded (it renders the hero headline, the LCP
 * element). "Archivo Fallback" is metric-matched Arial, which keeps layout
 * shift near zero while the web font loads.
 */
import type { Locale } from '@/i18n/config';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import archivoLatinExt from '@fontsource-variable/archivo/files/archivo-latin-ext-wdth-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import kufiArabic from '@fontsource-variable/noto-kufi-arabic/files/noto-kufi-arabic-arabic-wght-normal.woff2?url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const ARABIC = 'U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0897-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC';

const css = `
@font-face{font-family:'Archivo';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivoLatin}) format('woff2-variations'),url(${archivoLatin}) format('woff2');unicode-range:${LATIN}}
@font-face{font-family:'Archivo';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivoLatinExt}) format('woff2-variations'),url(${archivoLatinExt}) format('woff2');unicode-range:${LATIN_EXT}}
@font-face{font-family:'Archivo Fallback';src:local('Arial'),local('ArialMT'),local('Helvetica Neue'),local('Helvetica');ascent-override:85%;descent-override:20.3%;line-gap-override:0%;size-adjust:103.3%}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:100 800;src:url(${monoLatin}) format('woff2-variations'),url(${monoLatin}) format('woff2');unicode-range:${LATIN}}
@font-face{font-family:'Noto Kufi Arabic';font-style:normal;font-display:swap;font-weight:100 900;src:url(${kufiArabic}) format('woff2-variations'),url(${kufiArabic}) format('woff2');unicode-range:${ARABIC}}
`;
---

<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
{locale === 'ar' && <link rel="preload" href={kufiArabic} as="font" type="font/woff2" crossorigin />}
<style is:inline set:html={css}></style>
