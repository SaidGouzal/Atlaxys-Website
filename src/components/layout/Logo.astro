---
/**
 * The official Atlaxys lockup (transparent versions generated by
 * scripts/brand-assets.mjs from the supplied logo file): white letters for
 * dark surfaces, ink letters for light ones. Both are rendered and the theme
 * tokens (--logo-on-dark / --logo-on-light) show the one that suits the
 * surface it sits on, so it follows the page theme and paper sections alike.
 * The hidden one is display:none, so it is neither announced nor, when lazy,
 * downloaded.
 */
import { Picture } from 'astro:assets';
import { site } from '@/config/site';
import wordmark from '@/assets/brand/atlaxys-wordmark.png';
import wordmarkInk from '@/assets/brand/atlaxys-wordmark-ink.png';

interface Props {
  /** Rendered width in px (height follows the logo's proportions). */
  width?: number;
  /** Defaults to the company name: an empty alt is reported as missing alt text by SEO crawlers. */
  alt?: string;
  eager?: boolean;
  class?: string;
}

const { width = 136, alt = site.name, eager = true, class: className } = Astro.props;
const height = Math.round((width * wordmark.height) / wordmark.width);
---

{
  [
    { src: wordmark, variant: 'on-dark' },
    { src: wordmarkInk, variant: 'on-light' },
  ].map(({ src, variant }) => (
    <Picture
      src={src}
      alt={alt}
      width={width}
      height={height}
      densities={[1, 2, 3]}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['logo', `logo--${variant}`, className]}
    />
  ))
}

<style>
  .logo {
    height: auto;
  }

  .logo--on-dark {
    display: var(--logo-on-dark, block);
  }

  .logo--on-light {
    display: var(--logo-on-light, none);
  }
</style>
