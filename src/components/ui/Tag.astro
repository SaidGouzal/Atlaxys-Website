---
/** Small metadata chip (technology, category, status). */
interface Props {
  tone?: 'default' | 'signal' | 'muted';
  status?: 'available' | 'beta' | 'in-development' | 'coming-soon';
  class?: string;
}
const { tone = 'default', status, class: className } = Astro.props;
---

<span class:list={['tag', `tag--${tone}`, status && `tag--status tag--${status}`, className]}>
  {status && <span class="tag__dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.7em;
    border: 1px solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--color-text-2);
    white-space: nowrap;
  }

  :global(:lang(ar)) .tag {
    font-family: var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--step--1);
  }

  .tag--signal {
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    color: var(--color-accent);
  }

  .tag--muted {
    color: var(--color-muted);
    border-color: var(--color-line);
  }

  .tag__dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .tag--available .tag__dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .tag--beta .tag__dot {
    background: linear-gradient(90deg, var(--color-accent) 50%, transparent 50%);
    border-color: var(--color-accent);
  }
</style>
