---
/**
 * Generic card: hairline frame, chamfered corner, whole-card link with a
 * single accessible name (the heading link stretches over the card).
 */
interface Props {
  href?: string;
  class?: string;
  tone?: 'default' | 'raised';
}
const { href, class: className, tone = 'default' } = Astro.props;
---

<article class:list={['card', `card--${tone}`, { 'card--link': href }, className]}>
  <slot />
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .card--raised {
    background: var(--color-surface);
  }

  .card--link:hover,
  .card--link:focus-within {
    border-color: var(--color-line-strong);
    background: var(--color-surface-2);
  }

  /* A heading link inside the card with class "card-link" covers the card. */
  .card :global(.card-link) {
    color: inherit;
    text-decoration: none;
  }

  .card :global(.card-link)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card :global(.card-link:focus-visible) {
    outline: none;
  }

  .card :global(.card-link:focus-visible)::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
