---
/**
 * Muted, inline, decorative-or-demo video. Autoplay only happens when the
 * visitor allows motion; otherwise the poster frame shows. Native controls
 * are always present so a looping video can be paused (WCAG 2.2.2).
 * Provide `captions` (WebVTT) for any video that carries speech.
 */
interface Props {
  src: string;
  type?: string;
  poster?: string;
  label: string;
  captions?: { src: string; srclang: string; label: string };
  autoplay?: boolean;
  loop?: boolean;
  class?: string;
}

const { src, type = 'video/mp4', poster, label, captions, autoplay = true, loop = true, class: className } = Astro.props;
---

<video
  class:list={['video', className]}
  poster={poster}
  muted
  playsinline
  loop={loop}
  preload="none"
  aria-label={label}
  data-autoplay={autoplay ? '' : undefined}
  controls
>
  <source src={src} type={type} />
  {captions && <track kind="captions" src={captions.src} srclang={captions.srclang} label={captions.label} default />}
</video>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
    if (reduce.matches) return;
    // Autoplay while visible — unless the visitor paused it themselves.
    let userPaused = false;
    video.addEventListener('pause', () => {
      if (document.visibilityState === 'visible' && video.dataset.autoPausing !== 'true') userPaused = true;
      delete video.dataset.autoPausing;
    });
    video.addEventListener('play', () => (userPaused = false));
    const io = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) {
        if (!userPaused) void video.play().catch(() => undefined);
      } else if (!video.paused) {
        video.dataset.autoPausing = 'true';
        video.pause();
      }
    });
    io.observe(video);
  });
</script>

<style>
  .video {
    width: 100%;
    height: auto;
    background: var(--color-surface-2);
  }
</style>
