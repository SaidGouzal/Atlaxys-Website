---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  width?: 'default' | 'narrow';
  class?: string;
}

const { width = 'default', class: className, ...rest } = Astro.props;
---

<div class:list={['container', { 'container--narrow': width === 'narrow' }, className]} {...rest}>
  <slot />
</div>
