---
/** Numbered principles with a sticky title column on wide screens. */
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  index?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  items: { title: string; text: string }[];
  id?: string;
}

const { index, eyebrow, title, intro, items, id = 'principles-title' } = Astro.props;
---

<div class="principles">
  <div class="principles__head">
    <SectionHeader id={id} index={index} eyebrow={eyebrow} title={title} intro={intro} size="md" />
  </div>
  <ol role="list" class="principles__list">
    {
      items.map((item, i) => (
        <li class="principle" data-reveal>
          <span class="principle__num mono tabular">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="principle__title">{item.title}</h3>
          <p class="principle__text">{item.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .principles {
    display: grid;
    gap: var(--space-l);
  }

  .principles__head :global(.section-header) {
    margin-block-end: 0;
  }

  .principles__head :global(.section-header__title),
  .principles__head :global(.section-header__intro) {
    grid-column: 1 / -1;
  }

  .principles__list {
    border-top: 1px solid var(--color-line);
  }

  .principle {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--color-line);
  }

  .principle__num {
    grid-row: span 2;
    color: var(--color-accent);
    padding-block-start: 0.35rem;
  }

  .principle__title {
    font-size: var(--step-2);
    font-weight: 650;
    line-height: 1.2;
  }

  .principle__text {
    color: var(--color-text-2);
    max-width: 52ch;
  }

  @media (min-width: 64rem) {
    .principles {
      grid-template-columns: 5fr 7fr;
      gap: var(--grid-gap);
      align-items: start;
    }

    .principles__head {
      position: sticky;
      top: calc(var(--header-height) + var(--space-l));
    }
  }
</style>
