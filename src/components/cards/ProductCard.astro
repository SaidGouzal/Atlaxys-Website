---
/**
 * Product row/card. Products are visually distinct from services: they carry
 * a status, platforms and a "product" label, and live on light "paper".
 */
import { useTranslations, type Locale } from '@/i18n';
import type { Product } from '@/lib/content';
import Icon from '../ui/Icon.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  product: Product;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { product, locale, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel;
const statusLabel = {
  available: t.labels.statusAvailable,
  beta: t.labels.statusBeta,
  'in-development': t.labels.statusInDevelopment,
  'coming-soon': t.labels.statusComingSoon,
}[product.status];
---

<article class="product-card">
  <div class="product-card__top">
    <span class="product-card__kind mono">{t.labels.product} · {product.category}</span>
    <Tag status={product.status}>{statusLabel}</Tag>
  </div>
  <Heading class="product-card__name">
    <a href={product.url} class="product-card__link">{product.name}</a>
  </Heading>
  <p class="product-card__tagline">{product.tagline}</p>
  <div class="product-card__foot">
    {product.platforms.length > 0 && <span class="product-card__platforms mono">{product.platforms.join(' / ')}</span>}
    <span class="product-card__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-s);
    height: 100%;
    padding: var(--space-l);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    clip-path: polygon(0 0, calc(100% - var(--chamfer-lg)) 0, 100% var(--chamfer-lg), 100% 100%, 0 100%);
    transition:
      border-color var(--dur-2),
      transform var(--dur-3) var(--ease-out);
  }

  :global([dir='rtl']) .product-card {
    clip-path: polygon(var(--chamfer-lg) 0, 100% 0, 100% 100%, 0 100%, 0 var(--chamfer-lg));
  }

  .product-card:hover {
    border-color: var(--color-line-strong);
    transform: translateY(-4px);
  }

  .product-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .product-card__kind {
    color: var(--color-muted);
  }

  .product-card__name {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 760;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-block-start: var(--space-s);
  }

  .product-card__link {
    color: inherit;
    text-decoration: none;
  }

  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  .product-card__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: -4px;
  }

  .product-card__tagline {
    color: var(--color-text-2);
    max-width: 38ch;
  }

  .product-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-start: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .product-card__platforms {
    color: var(--color-muted);
  }

  .product-card__arrow {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    margin-inline-start: auto;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .product-card:hover .product-card__arrow {
    transform: rotate(45deg);
  }
</style>
