---
/** Article as an editorial index row: date · title · category · reading time. */
import { formatDate, useTranslations, type Locale } from '@/i18n';
import type { Post } from '@/lib/content';
import Icon from '../ui/Icon.astro';

interface Props {
  post: Post;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { post, locale, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel;
---

<article class="post-row">
  <time class="post-row__date mono tabular" datetime={post.data.publishedAt.toISOString()}>
    {formatDate(post.data.publishedAt, locale, 'short')}
  </time>
  <div class="post-row__main">
    <Heading class="post-row__title">
      <a href={post.url} class="post-row__link">{post.data.title}</a>
    </Heading>
    <p class="post-row__excerpt">{post.data.description}</p>
  </div>
  <p class="post-row__meta mono">
    <span>{post.data.category}</span>
    <span>{t.labels.minRead(post.readingMinutes)}</span>
  </p>
  <span class="post-row__arrow" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
</article>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'date arrow'
      'main main'
      'meta meta';
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--color-line);
  }

  .post-row__date {
    grid-area: date;
    color: var(--color-muted);
  }

  .post-row__main {
    grid-area: main;
    display: grid;
    gap: var(--space-2xs);
  }

  .post-row__title {
    font-size: var(--step-2);
    font-weight: 620;
    line-height: 1.2;
    max-width: 36ch;
    transition: color var(--dur-2);
  }

  .post-row__link {
    color: inherit;
    text-decoration: none;
  }

  .post-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-row__link:focus-visible {
    outline: none;
  }

  .post-row__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .post-row:hover .post-row__title {
    color: var(--color-accent);
  }

  .post-row__excerpt {
    color: var(--color-text-2);
    font-size: var(--step--1);
    max-width: 62ch;
  }

  .post-row__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--color-muted);
  }

  .post-row__arrow {
    grid-area: arrow;
    color: var(--color-accent);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .post-row:hover .post-row__arrow {
    transform: translateX(0.3rem);
  }

  @media (min-width: 64rem) {
    .post-row {
      grid-template-columns: 9rem minmax(0, 1fr) 14rem auto;
      grid-template-areas: 'date main meta arrow';
      align-items: baseline;
    }

    .post-row__meta {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
