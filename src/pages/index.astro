---
/**
 * Root URL. In production App Platform answers "/" with a 301 to /en/
 * (ingress rule in .do/app.yaml), so this page is only the fallback: it sends
 * visitors to their language (an explicit earlier choice first, then the
 * browser's preferred languages, then English), and crawlers and visitors
 * without JavaScript follow the meta refresh to /en/.
 *
 * No `noindex`: together with the canonical it would send search engines
 * contradictory signals. An instant meta refresh plus a canonical to /en/ is
 * read as a permanent redirect, which is what this page stands in for.
 */
import { site } from '@/config/site';
import { defaultLocale, localeMeta, locales } from '@/i18n/config';
import { absoluteUrl } from '@/lib/seo/urls';

const target = `/${defaultLocale}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{site.name}</title>
    {Object.entries(site.verification).map(([name, content]) => <meta name={name} content={content} />)}
    <link rel="canonical" href={absoluteUrl(target)} />
    {locales.map((l) => <link rel="alternate" hreflang={localeMeta[l].hreflang} href={absoluteUrl(`/${l}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(target)} />
    <script is:inline define:vars={{ locales, fallback: defaultLocale }}>
      (function () {
        var pick = fallback;
        try {
          var saved = localStorage.getItem('atlaxys-lang');
          if (saved && locales.indexOf(saved) > -1) pick = saved;
          else {
            var prefs = navigator.languages || [navigator.language || ''];
            for (var i = 0; i < prefs.length; i++) {
              var code = String(prefs[i]).slice(0, 2).toLowerCase();
              if (locales.indexOf(code) > -1) {
                pick = code;
                break;
              }
            }
          }
        } catch (e) {}
        window.location.replace('/' + pick + '/' + window.location.search + window.location.hash);
      })();
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>
      body {
        background: #08090b;
        color: #f2f4f7;
        font-family: system-ui, sans-serif;
      }
    </style>
  </head>
  <body>
    <p><a href={target}>{site.name}</a></p>
  </body>
</html>
