---
/**
 * Campaign landing pages (Meta / Instagram / Google Ads).
 *
 * One JSON file in src/content/landing-pages/<locale>/<slug>.json = one page
 * at /<locale>/landing/<slug>/. Sections are optional and can be reordered
 * with the `sections` array. Built for cold mobile traffic: the offer is clear
 * in the first screen, the page is light (no GSAP, no WebGL), a sticky bar
 * keeps "get a quote" and WhatsApp one tap away, and the form sits beside the
 * story on desktop.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseCard from '@/components/cards/CaseCard.astro';
import ProductCard from '@/components/cards/ProductCard.astro';
import LeadForm from '@/components/forms/LeadForm.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SignalRule from '@/components/ui/SignalRule.astro';
import { whatsappLink } from '@/config/site';
import { useTranslations } from '@/i18n';
import { getCaseStudies, getLandingAlternates, getLandingPaths, getProducts, type LandingPage } from '@/lib/content';
import { faqNode } from '@/lib/seo/schema';

export const getStaticPaths = getLandingPaths;

interface Props {
  landing: LandingPage;
}

const { landing } = Astro.props;
const { locale, data } = landing;
const t = useTranslations(locale);
const [alternates, caseStudies, products] = await Promise.all([
  getLandingAlternates(landing.key),
  getCaseStudies(locale),
  getProducts(locale),
]);
const proofCases = data.proof ? caseStudies.filter((c) => data.proof!.caseStudies.includes(c.key)) : [];
const proofProducts = data.proof ? products.filter((p) => data.proof!.products.includes(p.key)) : [];
const order = data.sections ?? ['hero', 'audience', 'problem', 'solution', 'benefits', 'proof', 'process', 'faq', 'form'];
const show = (s: (typeof order)[number]) => order.includes(s);
const waMessage = data.hero.whatsappMessage ?? t.whatsapp.message;
const waHref = whatsappLink(waMessage);
const bodySections = order.filter((s) => s !== 'hero' && s !== 'form');
---

<BaseLayout
  locale={locale}
  variant="landing"
  page="landing"
  whatsappFloat={false}
  schema={[data.faq && show('faq') ? faqNode(landing.url, data.faq.items) : undefined]}
  seo={{ title: data.seo.title, description: data.seo.description, noindex: data.seo.noindex, alternates }}
>
  {
    show('hero') && (
      <section class="lp-hero bg-grid" aria-labelledby="lp-title">
        <div class="container lp-hero__inner">
          {data.hero.eyebrow && (
            <p class="eyebrow eyebrow--accent">
              <SignalRule length={40} animate={false} />
              <span>{data.hero.eyebrow}</span>
            </p>
          )}
          <h1 id="lp-title" class="lp-hero__title">
            {data.hero.title}
          </h1>
          <p class="lp-hero__lead">{data.hero.lead}</p>
          {data.hero.bullets.length > 0 && (
            <ul role="list" class="lp-hero__bullets">
              {data.hero.bullets.map((b) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
          <div class="lp-hero__actions">
            <Button href="#lead-form" size="lg" icon="arrow-down" data-track="landing_cta_click" data-track-location="hero">
              {data.hero.primaryCta ?? t.landing.formTitle}
            </Button>
            <Button
              href={waHref}
              variant="secondary"
              size="lg"
              icon="whatsapp"
              target="_blank"
              rel="noopener noreferrer"
              data-track="whatsapp_click"
              data-track-location="landing-hero"
            >
              {data.hero.whatsappCta ?? t.cta.whatsapp}
            </Button>
          </div>
        </div>
      </section>
    )
  }

  <div class="container lp-body">
    <div class="lp-story">
      {
        bodySections.map((s) => {
          if (s === 'audience' && data.audience)
            return (
              <section class="lp-section" aria-labelledby="lp-audience">
                <h2 id="lp-audience" class="lp-h2">
                  {data.audience.title}
                </h2>
                <ul role="list" class="lp-chips">
                  {data.audience.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            );
          if (s === 'problem' && data.problem)
            return (
              <section class="lp-section" aria-labelledby="lp-problem">
                <h2 id="lp-problem" class="lp-h2">
                  {data.problem.title}
                </h2>
                {data.problem.intro && <p class="lp-text">{data.problem.intro}</p>}
                <ul role="list" class="lp-problems">
                  {data.problem.points.map((p) => (
                    <li>
                      <span class="lp-problems__x" aria-hidden="true">
                        ×
                      </span>
                      {p}
                    </li>
                  ))}
                </ul>
              </section>
            );
          if (s === 'solution' && data.solution)
            return (
              <section class="lp-section" aria-labelledby="lp-solution">
                <h2 id="lp-solution" class="lp-h2">
                  {data.solution.title}
                </h2>
                <p class="lp-text">{data.solution.text}</p>
                {data.solution.points.length > 0 && (
                  <ul role="list" class="lp-grid">
                    {data.solution.points.map((p) => (
                      <li class="lp-card">
                        <h3>{p.title}</h3>
                        <p>{p.text}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            );
          if (s === 'benefits' && data.benefits)
            return (
              <section class="lp-section" aria-labelledby="lp-benefits">
                <h2 id="lp-benefits" class="lp-h2">
                  {data.benefits.title}
                </h2>
                <ul role="list" class="lp-benefits">
                  {data.benefits.items.map((b, i) => (
                    <li>
                      <span class="mono tabular">{String(i + 1).padStart(2, '0')}</span>
                      <div>
                        <h3>{b.title}</h3>
                        <p>{b.text}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            );
          if (s === 'proof' && data.proof)
            return (
              <section class="lp-section" aria-labelledby="lp-proof">
                <h2 id="lp-proof" class="lp-h2">
                  {data.proof.title}
                </h2>
                {data.proof.text && <p class="lp-text">{data.proof.text}</p>}
                {data.proof.items.length > 0 && (
                  <ul role="list" class="lp-grid">
                    {data.proof.items.map((p) => (
                      <li class="lp-card lp-card--proof">
                        <Icon name="check" size={20} />
                        <h3>{p.title}</h3>
                        <p>{p.text}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {proofProducts.length > 0 && (
                  <div class="lp-grid lp-grid--cards">
                    {proofProducts.map((p) => (
                      <ProductCard product={p} locale={locale} />
                    ))}
                  </div>
                )}
                {proofCases.length > 0 && (
                  <div class="lp-grid lp-grid--cards">
                    {proofCases.map((c) => (
                      <CaseCard item={c} locale={locale} />
                    ))}
                  </div>
                )}
              </section>
            );
          if (s === 'process' && data.process)
            return (
              <section class="lp-section" aria-labelledby="lp-process">
                <h2 id="lp-process" class="lp-h2">
                  {data.process.title}
                </h2>
                <ol role="list" class="lp-steps">
                  {data.process.steps.map((step, i) => (
                    <li>
                      <span class="lp-steps__num tabular">{i + 1}</span>
                      <div>
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            );
          if (s === 'faq' && data.faq)
            return (
              <section class="lp-section" aria-labelledby="lp-faq">
                <h2 id="lp-faq" class="lp-h2">
                  {data.faq.title}
                </h2>
                <Accordion items={data.faq.items} group="lp-faq" />
              </section>
            );
          return null;
        })
      }
    </div>

    {
      show('form') && (
        <aside class="lp-form" aria-labelledby="lp-form-title">
          <div class="lp-form__panel">
            <h2 id="lp-form-title" class="lp-form__title">
              {data.form.title ?? t.landing.formTitle}
            </h2>
            <p class="lp-form__text">{data.form.text ?? t.landing.formText}</p>
            <LeadForm
              locale={locale}
              variant={data.form.variant}
              name="landing"
              landing={`${locale}/${landing.slug}`}
              campaign={data.campaign ?? ''}
              projectType={data.form.projectType}
              whatsappMessage={waMessage}
            />
            <p class="lp-form__or">
              <span>{t.landing.or}</span>
            </p>
            <a href={waHref} class="lp-form__wa" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="landing-form">
              <Icon name="whatsapp" size={20} />
              {data.hero.whatsappCta ?? t.cta.whatsapp}
              <span class="visually-hidden">{t.a11y.newTab}</span>
            </a>
          </div>
        </aside>
      )
    }
  </div>

  <div class="lp-sticky" data-lp-sticky>
    <a href="#lead-form" class="lp-sticky__primary" data-track="landing_cta_click" data-track-location="sticky">
      {data.hero.primaryCta ?? t.landing.menuContact}
    </a>
    <a href={waHref} class="lp-sticky__wa" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="sticky">
      <Icon name="whatsapp" size={22} />
      <span class="visually-hidden">{t.cta.whatsapp} {t.a11y.newTab}</span>
    </a>
  </div>
</BaseLayout>

<script>
  import { track } from '@/scripts/analytics/track';

  track('view_landing', { page_path: window.location.pathname });

  // Hide the sticky bar while the form itself is on screen.
  const sticky = document.querySelector<HTMLElement>('[data-lp-sticky]');
  const form = document.getElementById('lead-form');
  if (sticky && form && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => sticky.classList.toggle('is-hidden', Boolean(entry?.isIntersecting))).observe(form);
  }
</script>

<style>
  .lp-hero {
    padding-block: calc(var(--header-height) + var(--space-l)) var(--space-xl);
    border-bottom: 1px solid var(--color-line);
  }

  .lp-hero__inner {
    display: grid;
    gap: var(--space-m);
    max-width: 62rem;
    margin-inline: 0;
  }

  .lp-hero__title {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.1rem, 1.2rem + 4.2vw, 4.75rem);
    line-height: 1;
    text-wrap: balance;
  }

  :global(:lang(ar)) .lp-hero__title {
    line-height: 1.35;
  }

  .lp-hero__lead {
    font-size: var(--step-1);
    color: var(--color-text-2);
    max-width: 46ch;
  }

  .lp-hero__bullets {
    display: grid;
    gap: 0.6rem;
  }

  .lp-hero__bullets li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }

  .lp-hero__bullets :global(.icon) {
    color: var(--color-accent);
    margin-block-start: 0.2rem;
  }

  .lp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xs);
  }

  .lp-body {
    display: grid;
    gap: var(--space-2xl) var(--grid-gap);
    padding-block: var(--space-2xl);
  }

  @media (min-width: 64rem) {
    .lp-body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }

    .lp-form {
      position: sticky;
      top: var(--space-l);
    }

    .lp-hero__inner {
      max-width: calc(58.33% - var(--grid-gap));
    }
  }

  .lp-story {
    display: grid;
    gap: var(--space-2xl);
    min-width: 0;
  }

  .lp-section {
    display: grid;
    gap: var(--space-m);
  }

  .lp-h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 720;
    font-size: var(--step-3);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 24ch;
  }

  :global(:lang(ar)) .lp-h2 {
    font-stretch: 100%;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .lp-text {
    color: var(--color-text-2);
    font-size: var(--step-1);
    max-width: 56ch;
  }

  .lp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lp-chips li {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    font-size: var(--step--1);
  }

  .lp-problems {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .lp-problems li {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-2);
  }

  .lp-problems__x {
    color: var(--color-accent);
    font-weight: 800;
    font-size: 1.25em;
  }

  .lp-grid {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 40rem) {
    .lp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .lp-card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .lp-card h3 {
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .lp-card p {
    color: var(--color-text-2);
    font-size: var(--step--1);
  }

  .lp-card--proof :global(.icon) {
    color: var(--color-accent);
  }

  .lp-benefits {
    display: grid;
    gap: var(--space-m);
  }

  .lp-benefits li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-xs);
  }

  .lp-benefits .mono {
    color: var(--color-accent);
    padding-block-start: 0.3rem;
  }

  .lp-benefits h3 {
    font-weight: 650;
    font-size: var(--step-1);
  }

  .lp-benefits p {
    color: var(--color-text-2);
  }

  .lp-steps {
    display: grid;
    gap: var(--space-m);
  }

  .lp-steps li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: var(--space-s);
    align-items: start;
  }

  .lp-steps__num {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    font-weight: 700;
    color: var(--color-accent);
  }

  .lp-steps h3 {
    font-weight: 650;
    font-size: var(--step-1);
  }

  .lp-steps p {
    color: var(--color-text-2);
  }

  .lp-form__panel {
    display: grid;
    gap: var(--space-m);
    padding: clamp(1.25rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }

  .lp-form__title {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 720;
    font-size: var(--step-2);
    line-height: 1.1;
  }

  :global(:lang(ar)) .lp-form__title {
    font-stretch: 100%;
    line-height: 1.5;
  }

  .lp-form__text {
    color: var(--color-muted);
    font-size: var(--step--1);
    margin-block-start: -0.5rem;
  }

  .lp-form__or {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .lp-form__or::before,
  .lp-form__or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }

  .lp-form__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    border: 1px solid var(--color-line-strong);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }

  .lp-form__wa :global(.icon) {
    color: var(--color-accent);
  }

  .lp-form__wa:hover {
    border-color: var(--color-text);
  }

  .lp-form :global(.lead-form__footer) {
    grid-template-columns: 1fr;
  }

  .lp-form :global(.lead-form__footer .btn) {
    width: 100%;
  }

  /* Sticky conversion bar — phones and tablets only. */
  .lp-sticky {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-float);
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem max(0.75rem, env(safe-area-inset-left)) max(0.6rem, env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--color-line);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .lp-sticky.is-hidden {
    transform: translateY(110%);
  }

  .lp-sticky__primary {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 650;
    text-decoration: none;
  }

  .lp-sticky__wa {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    min-height: 3rem;
    border: 1px solid var(--color-line-strong);
    color: var(--color-accent);
  }

  @media (min-width: 64rem) {
    .lp-sticky {
      display: none;
    }
  }

  :global(body.has-consent-banner) .lp-sticky {
    transform: translateY(110%);
  }
</style>
