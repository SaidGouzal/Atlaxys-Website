# -----------------------------------------------------------------------------
# Atlaxys website — environment variables
# Copy to `.env` for local development. On DigitalOcean App Platform, set these
# in the component's "Environment Variables" panel (mark secrets as encrypted).
# -----------------------------------------------------------------------------

# Canonical origin (no trailing slash). Used for canonical URLs, hreflang,
# sitemap and Open Graph. MUST be set to the production domain.
SITE_URL=https://atlaxys.com

# Build mode. Leave empty for the default (static pages + Node lead endpoint).
# Set to "static" for a pure static build (no server). See docs/DEPLOYMENT.md.
OUTPUT=

# Where the contact / landing forms POST to. Defaults to "/api/contact/".
# In OUTPUT=static mode, point this to an external form service.
PUBLIC_CONTACT_ENDPOINT=

# ---- Analytics (all optional; nothing loads until the visitor consents) ----
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=

# ---- Lead delivery (server only) ----
# Where new leads are emailed (via the Resend HTTP API).
LEAD_EMAIL_TO=
# Verified sender, e.g. "Atlaxys Website <website@atlaxys.com>".
LEAD_EMAIL_FROM=
RESEND_API_KEY=

# Optional: POST every lead as JSON to a webhook (n8n, Make, Zapier, Slack, CRM…)
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the `X-Atlaxys-Signature` HMAC-SHA256 header.
LEAD_WEBHOOK_SECRET=
